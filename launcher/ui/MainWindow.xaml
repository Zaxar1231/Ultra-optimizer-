<!-- Main window content. Loaded at runtime with XamlReader; event handlers are wired in App.cs by x:Name. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Background="{DynamicResource Surface}" UseLayoutRounding="True"
      TextElement.FontFamily="{StaticResource TextFont}" TextElement.FontSize="14"
      TextElement.Foreground="{DynamicResource OnSurface}" TextOptions.TextFormattingMode="Display">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================================================================ NAVIGATION RAIL -->
    <DockPanel Grid.Column="0">
        <Button x:Name="ThemeToggle" DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Tag="&#xE708;"
                ToolTip="Светлая / тёмная тема" Margin="0,0,0,20"/>
        <StackPanel Margin="0,20,0,0">
            <Button x:Name="FabOptimize" Style="{StaticResource Fab}" Tag="&#xE945;" ToolTip="Оптимизировать"
                    HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Главная" IsChecked="True"/>
            <RadioButton x:Name="NavOptimize" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Оптимизация"/>
            <RadioButton x:Name="NavCustomize" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE771;" Content="Настройка"/>
            <RadioButton x:Name="NavBench" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Замер"/>
            <RadioButton x:Name="NavTools" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Инструменты"/>
            <RadioButton x:Name="NavLog" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Журнал"/>
            <RadioButton x:Name="NavAbout" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="О программе"/>
        </StackPanel>
    </DockPanel>

    <!-- ================================================================ CONTENT PANE -->
    <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerLow}" CornerRadius="24" Margin="0,8,8,8">
        <Grid x:Name="Pages">

            <!-- ============================================================ HOME -->
            <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,32,36,36" MaxWidth="1040">
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="Ultimate Optimizer"/>
                    <TextBlock Style="{StaticResource BodyMedium}" FontSize="15" Margin="0,6,0,24"
                               Text="Обратимая оптимизация Windows 10 и 11. Перед каждым изменением сохраняется старое значение — всё возвращается одной кнопкой."/>

                    <!-- MD3 banner: new version available -->
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="20" Background="{DynamicResource TertiaryContainer}" Padding="20,14" Margin="0,0,0,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource OnTertiaryContainer}" Opacity="0.12" Margin="0,0,-40,0"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Width="40" Text="&#xE896;" FontSize="20" Foreground="{DynamicResource OnTertiaryContainer}" Margin="0,0,16,0"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="BannerLater" Style="{StaticResource TextButton}" Foreground="{DynamicResource OnTertiaryContainer}" Content="Позже"/>
                                <Button x:Name="BannerUpdate" Style="{StaticResource FilledButton}" Tag="&#xE896;" Content="Обновить" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BannerTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource OnTertiaryContainer}" Text="Доступна новая версия"/>
                                <TextBlock x:Name="BannerText" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.85" Foreground="{DynamicResource OnTertiaryContainer}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="Hero" CornerRadius="28" Background="{DynamicResource PrimaryContainer}" Padding="32,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border x:Name="HeroChip" CornerRadius="8" Background="{DynamicResource Primary}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock x:Name="HeroChipText" Text="Не оптимизировано" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnPrimary}"/>
                                </Border>
                                <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="26" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnPrimaryContainer}" Text="Разгоним этот компьютер"/>
                                <TextBlock x:Name="HeroText" Margin="0,8,0,22" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                           Foreground="{DynamicResource OnPrimaryContainer}" Opacity="0.85"
                                           Text="Питание, задержки, игры, интерфейс и телеметрия — настройки подбираются под железо. Займёт 3–10 минут."/>
                                <WrapPanel>
                                    <Button x:Name="HomeOptimize" Style="{StaticResource FilledButton}" Tag="&#xE945;" Content="Оптимизировать" Margin="0,0,8,8"/>
                                    <Button x:Name="HomeUndo" Style="{StaticResource OutlinedButton}" Tag="&#xE7A7;" Content="Откатить всё" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="136" Height="136" Margin="28,0,0,0" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource Primary}" Opacity="0.12"/>
                                <Ellipse Fill="{DynamicResource Primary}" Opacity="0.14" Margin="20"/>
                                <TextBlock x:Name="HeroIcon" Style="{StaticResource Icon}" Text="&#xE945;" FontSize="52" Foreground="{DynamicResource Primary}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource TitleSmall}" Text="Этот компьютер"/>
                    <UniformGrid x:Name="InfoGrid" Columns="3" Margin="0,0,-12,0"/>
                    <WrapPanel x:Name="HintChips" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ OPTIMIZE -->
            <ScrollViewer x:Name="PageOptimize" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="36,32,36,36" MaxWidth="1040">
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="Оптимизация"/>
                    <TextBlock Style="{StaticResource BodyMedium}" FontSize="15" Margin="0,6,0,0"
                               Text="Создаётся точка восстановления и точный бэкап каждого значения в C:\ProgramData\UltimateOptimizer. Повторный запуск безопасен."/>

                    <TextBlock Style="{StaticResource TitleSmall}" Text="Профиль"/>
                    <UniformGrid x:Name="ProfileGrid" Columns="4" Margin="0,0,-12,0"/>

                    <DockPanel Margin="4,20,0,10">
                        <Button x:Name="TweaksAll" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Развернуть все"/>
                        <Button x:Name="TweaksReset" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Tag="&#xE72C;" Content="Сбросить" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TweaksTitle" Style="{StaticResource TitleSmall}" Margin="0" VerticalAlignment="Center" Text="Твики"/>
                    </DockPanel>
                    <StackPanel x:Name="TweakGroups"/>

                    <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="OptRun" Style="{StaticResource FilledButton}" Tag="&#xE768;" Content="Запустить оптимизацию" Margin="0,0,8,8"/>
                        <Button x:Name="OptUndo" Style="{StaticResource TextButton}" Tag="&#xE7A7;" Content="Откатить всё" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ CUSTOMIZE -->
            <ScrollViewer x:Name="PageCustomize" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="36,32,36,36" MaxWidth="1040">
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="Настройка Windows"/>
                    <TextBlock Style="{StaticResource BodyMedium}" FontSize="15" Margin="0,6,0,20"
                               Text="Переключатели показывают текущее состояние и применяются сразу. Вернуть — тем же переключателем. Эти настройки не входят в бэкап оптимизации."/>
                    <Border x:Name="CzBanner" Visibility="Collapsed" CornerRadius="20" Background="{DynamicResource SecondaryContainer}" Padding="20,12" Margin="0,0,0,16">
                        <DockPanel>
                            <Button x:Name="CzRestartExplorer" DockPanel.Dock="Right" Style="{StaticResource FilledButton}" Tag="&#xE72C;" Content="Перезапустить Проводник" Margin="12,0,0,0"/>
                            <TextBlock Style="{StaticResource Icon}" DockPanel.Dock="Left" Text="&#xE946;" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource OnSecondaryContainer}"/>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource OnSecondaryContainer}"
                                       Text="Часть изменений появится после перезапуска Проводника (панель задач и окна папок мигнут на секунду)."/>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="CzGroups"/>
                    <TextBlock Style="{StaticResource BodyMedium}" FontSize="12" Margin="4,8,0,0"
                               Text="Набор настроек основан на разделе Customize проекта optimizerDuck (GPL-3.0), реализация своя."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ BENCHMARK -->
            <ScrollViewer x:Name="PageBench" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="36,32,36,36" MaxWidth="1040">
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="Замер «до» и «после»"/>
                    <TextBlock Style="{StaticResource BodyMedium}" FontSize="15" Margin="0,6,0,24"
                               Text="Замер «до» делается сам перед первой оптимизацией, «после» — сам при первом запуске после перезагрузки. Перед ручным замером закрой тяжёлые программы."/>
                    <Border CornerRadius="28" Background="{DynamicResource SecondaryContainer}" Padding="32,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BenchHeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="26" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSecondaryContainer}" Text="Замеров ещё нет"/>
                                <TextBlock x:Name="BenchHeroText" Margin="0,8,0,20" TextWrapping="Wrap" FontSize="14" LineHeight="21" Opacity="0.85"
                                           Foreground="{DynamicResource OnSecondaryContainer}"/>
                                <WrapPanel>
                                    <Button x:Name="BenchRun" Style="{StaticResource FilledButton}" Tag="&#xE9D9;" Content="Измерить сейчас" Margin="0,0,8,8"/>
                                    <Button x:Name="BenchReset" Style="{StaticResource TextButton}" Foreground="{DynamicResource OnSecondaryContainer}" Content="Сбросить замеры" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="BenchHeroScore" Grid.Column="1" Margin="28,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="BenchHeroValue" FontFamily="{StaticResource DisplayFont}" FontSize="60" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="BenchHeroCaption" FontSize="13" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" Opacity="0.85"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource TitleSmall}" Text="Показатели"/>
                    <UniformGrid x:Name="BenchGrid" Columns="3" Margin="0,0,-12,0"/>
                    <TextBlock x:Name="BenchNote" Style="{StaticResource BodyMedium}" FontSize="12" Margin="4,8,0,0"
                               Text="Задержка отклика — время пробуждения потока после сигнала (медиана). Время загрузки берётся из журнала Windows и обновляется после перезагрузки."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ TOOLS -->
            <ScrollViewer x:Name="PageTools" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="36,32,36,36" MaxWidth="1040">
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="Инструменты"/>
                    <TextBlock Style="{StaticResource BodyMedium}" FontSize="15" Margin="0,6,0,20" Text="Починка Windows, отчёт о железе и другие утилиты."/>
                    <UniformGrid x:Name="ToolsGrid" Columns="2" Margin="0,0,-16,0">

                        <Border Style="{StaticResource OutlinedCard}" Margin="0,0,16,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource SecondaryContainer}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="22" Foreground="{DynamicResource OnSecondaryContainer}"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleLarge}" Text="Починка Windows" Margin="0,16,0,6"/>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMedium}" Margin="0,0,0,16"
                                           Text="Если Windows глючит, не обновляется или пропал интернет. DISM и SFC занимают 5–20 минут."/>
                                <WrapPanel VerticalAlignment="Bottom">
                                    <Button x:Name="ToolRepair" Style="{StaticResource TonalButton}" Tag="&#xE90F;" Content="DISM + SFC" Margin="0,0,8,8"/>
                                    <Button x:Name="ToolNet" Style="{StaticResource TonalButton}" Tag="&#xE774;" Content="Сбросить сеть" Margin="0,0,8,8"/>
                                    <Button x:Name="ToolRestore" Style="{StaticResource TextButton}" Content="Точки восстановления" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource OutlinedCard}" Margin="0,0,16,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource TertiaryContainer}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="22" Foreground="{DynamicResource OnTertiaryContainer}"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleLarge}" Text="Отчёт о ПК" Margin="0,16,0,6"/>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMedium}" Margin="0,0,0,16"
                                           Text="Процессор, видеокарта, память, здоровье дисков и батареи, BSOD за 30 дней, автозагрузка."/>
                                <WrapPanel VerticalAlignment="Bottom">
                                    <Button x:Name="ToolReport" Style="{StaticResource TonalButton}" Tag="&#xE8A7;" Content="Открыть отчёт" Margin="0,0,8,8"/>
                                    <Button x:Name="ToolReportSend" Style="{StaticResource TextButton}" Tag="&#xE715;" Content="Почта / Telegram" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource OutlinedCard}" Margin="0,0,16,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource PrimaryContainer}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="22" Foreground="{DynamicResource OnPrimaryContainer}"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleLarge}" Text="Очистка" Margin="0,16,0,6"/>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMedium}" Margin="0,0,0,16"
                                           Text="Временные файлы, старые компоненты обновлений Windows, TRIM для SSD и кэш DNS. Сколько освободилось — видно в «Замере»."/>
                                <WrapPanel VerticalAlignment="Bottom">
                                    <Button x:Name="ToolClean" Style="{StaticResource TonalButton}" Tag="&#xE74D;" Content="Очистить" Margin="0,0,8,8"/>
                                    <Button x:Name="ToolCleanMgr" Style="{StaticResource TextButton}" Content="Очистка диска Windows" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource OutlinedCard}" Margin="0,0,16,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource SurfaceContainerHighest}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="22" Foreground="{DynamicResource OnSurfaceVariant}"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleLarge}" Text="Файлы" Margin="0,16,0,6"/>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMedium}" Margin="0,0,0,16"
                                           Text="Бэкап настроек, логи каждого запуска и скачанные программы."/>
                                <WrapPanel VerticalAlignment="Bottom">
                                    <Button x:Name="ToolLogs" Style="{StaticResource TonalButton}" Tag="&#xE8B7;" Content="Бэкап и логи" Margin="0,0,8,8"/>
                                    <Button x:Name="ToolTools" Style="{StaticResource TextButton}" Content="C:\Tools" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ LOG -->
            <Grid x:Name="PageLog" Margin="36,32,36,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border x:Name="StatusChip" DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource SurfaceContainerHighest}"
                            Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Text="&#xE81C;" Margin="0,0,8,0"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                            <TextBlock x:Name="StatusText" Text="Нет задач" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariant}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="Журнал"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,16,0,16">
                    <TextBlock x:Name="CurrentStep" Style="{StaticResource TitleMedium}" Text="Запусти оптимизацию или инструмент — вывод появится здесь" Margin="0,0,0,12"/>
                    <Grid x:Name="ProgressHost" Height="4" ClipToBounds="True" Visibility="Hidden">
                        <Border CornerRadius="2" Background="{DynamicResource SecondaryContainer}"/>
                        <Canvas x:Name="ProgressCanvas">
                            <Border x:Name="ProgressBar" Height="4" Width="160" CornerRadius="2" Background="{DynamicResource Primary}"/>
                        </Canvas>
                    </Grid>
                </StackPanel>
                <Border Grid.Row="2" CornerRadius="16" Background="{DynamicResource SurfaceContainerLowest}"
                        BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
                    <Grid>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                            <StackPanel x:Name="LogLines" TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="12.5"/>
                        </ScrollViewer>
                        <StackPanel x:Name="LogEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="40" Foreground="{DynamicResource OutlineVariant}"/>
                            <TextBlock Style="{StaticResource BodyMedium}" Text="Пока пусто" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button x:Name="LogCopy" Style="{StaticResource TonalButton}" Tag="&#xE8C8;" Content="Копировать" Margin="0,0,8,0"/>
                    <Button x:Name="LogFolder" Style="{StaticResource TextButton}" Tag="&#xE8B7;" Content="Папка с логами"/>
                </WrapPanel>
            </Grid>

            <!-- ============================================================ ABOUT -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="36,32,36,36" MaxWidth="1040">
                    <TextBlock Style="{StaticResource HeadlineMedium}" Text="О программе"/>
                    <Border Style="{StaticResource OutlinedCard}" Margin="0,24,0,0" Padding="24">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="22" Background="{DynamicResource Primary}" Margin="0,0,20,0">
                                <Grid>
                                    <Ellipse Fill="{DynamicResource PrimaryContainer}" Margin="12"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="26" Foreground="{DynamicResource Primary}"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TitleLarge}" Text="Ultimate Optimizer"/>
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource BodyMedium}" Text="Версия" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource BodyMedium}" Text="Лицензия MIT · твики на основе плейбука AtlasOS v0.5.0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource TitleSmall}" Text="Тема"/>
                    <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Segment}" Tag="20,0,0,20" Content="Как в Windows"/>
                        <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Segment}" Tag="0" Content="Светлая"/>
                        <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Segment}" Tag="0,20,20,0" Content="Тёмная"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource TitleSmall}" Text="Обновления"/>
                    <Border Style="{StaticResource OutlinedCard}" Padding="0">
                        <StackPanel>
                            <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyLarge}" Text="Проверять обновления при запуске"/>
                                    <TextBlock Style="{StaticResource BodyMedium}" Margin="0,2,0,0"
                                               Text="Новая версия скачивается с GitHub, сверяется по SHA-256 и ставится одной кнопкой с перезапуском. Бэкап и настройки сохраняются."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Margin="20,14">
                                <Button x:Name="UpdateCheck" DockPanel.Dock="Right" Style="{StaticResource TonalButton}" Tag="&#xE72C;" Content="Проверить сейчас" Margin="16,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource BodyLarge}" Text="Обновления ещё не проверялись"/>
                                    <TextBlock x:Name="UpdateDetail" Style="{StaticResource BodyMedium}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource TitleSmall}" Text="Ссылки"/>
                    <WrapPanel>
                        <Button x:Name="LinkRepo" Style="{StaticResource OutlinedButton}" Tag="&#xE774;" Content="GitHub проекта" Margin="0,0,8,8"/>
                        <Button x:Name="LinkDuck" Style="{StaticResource OutlinedButton}" Tag="&#xE774;" Content="optimizerDuck (идеи твиков)" Margin="0,0,8,8"/>
                        <Button x:Name="LinkAtlas" Style="{StaticResource OutlinedButton}" Tag="&#xE774;" Content="AtlasOS" Margin="0,0,8,8"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource BodyMedium}" Margin="4,24,0,0"
                               Text="Используй на свой риск. Все изменения обратимы: «Откатить всё» возвращает исходные значения, плюс создаётся точка восстановления Windows."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

    <!-- ================================================================ SNACKBAR -->
    <Border x:Name="Snackbar" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="96,0,0,92"
            CornerRadius="6" Background="{DynamicResource InverseSurface}" MinWidth="360" MaxWidth="640" Padding="16,4,6,4" Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.3"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>
        <DockPanel MinHeight="44">
            <Button x:Name="SnackAction" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Foreground="{DynamicResource InversePrimary}" Content="OK" Margin="8,0,0,0"/>
            <TextBlock x:Name="SnackText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InverseOnSurface}" Margin="0,8"/>
        </DockPanel>
    </Border>

    <!-- ================================================================ DIALOG -->
    <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Rectangle Fill="{DynamicResource Scrim}" Opacity="0.4"/>
        <Border x:Name="DialogCard" Background="{DynamicResource SurfaceContainerHigh}" CornerRadius="28" Padding="24"
                MinWidth="320" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.3"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform/>
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Secondary}" Margin="0,0,0,16"/>
                <TextBlock x:Name="DialogTitle" Style="{StaticResource HeadlineSmall}" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DialogText" Style="{StaticResource BodyMedium}" Margin="0,16,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DialogCancel" Style="{StaticResource TextButton}" Content="Отмена" Margin="0,0,8,0"/>
                    <Button x:Name="DialogOk" Style="{StaticResource TextButton}" Content="OK"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
